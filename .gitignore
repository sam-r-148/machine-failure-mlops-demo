# Publish only the inference service. Training work stays local.
/*
!/.gitignore
!/.dockerignore
!/README.md
!/main.py
!/model.joblib
!/requirements.txt
!/Dockerfile
!/app/
/app/*
!/app/__init__.py
!/app/features.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
